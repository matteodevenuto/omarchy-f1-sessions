{
  "schemaVersion": 1,
  "id": "matteodevenuto.f1-sessions",
  "name": "F1 Sessions",
  "version": "0.3.0",
  "author": "matteodevenuto",
  "license": "MIT",
  "description": "Countdown to the next Formula 1 session with a full race-weekend schedule popup. Powered by OpenF1.",
  "homepage": "https://github.com/matteodevenuto/omarchy-f1-sessions",
  "repository": "https://github.com/matteodevenuto/omarchy-f1-sessions",
  "keywords": [
    "f1",
    "formula1",
    "motorsport",
    "racing",
    "schedule",
    "countdown",
    "openf1"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "F1 Sessions",
    "description": "Next F1 session countdown and race-weekend schedule, fed by OpenF1",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshMinutes": 60,
      "daysAhead": 21,
      "hideWhenQuiet": false,
      "use24h": true,
      "displayMode": "icon",
      "notifications": true,
      "notificationSound": true,
      "notificationSessions": "all"
    },
    "schema": [
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 10,
        "max": 360,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "daysAhead",
        "type": "integer",
        "label": "Show sessions up to this many days ahead",
        "min": 3,
        "max": 60,
        "step": 1,
        "defaultValue": 21
      },
      {
        "key": "hideWhenQuiet",
        "type": "boolean",
        "label": "Hide the bar widget when no sessions are within range",
        "defaultValue": false
      },
      {
        "key": "use24h",
        "type": "boolean",
        "label": "Use 24-hour times (local timezone)",
        "defaultValue": true
      },
      {
        "key": "displayMode",
        "type": "enum",
        "label": "Bar display mode",
        "options": ["next", "time", "weekend", "icon", "logo"],
        "defaultValue": "icon",
        "description": "Choose a countdown label, a compact bar icon, or the wide F1 logo. Right-clicking the widget also cycles this setting."
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Session alerts",
        "defaultValue": true,
        "description": "Notify five minutes before each session starts."
      },
      {
        "key": "notificationSound",
        "type": "boolean",
        "label": "Radio alert sound",
        "defaultValue": true,
        "description": "Play a short pit-wall radio-style cue with session alerts."
      },
      {
        "key": "notificationSessions",
        "type": "enum",
        "label": "Sessions to notify",
        "options": ["all", "competitive", "race"],
        "defaultValue": "all",
        "description": "Alert for every session, competitive sessions only (no practice), or Grand Prix and Sprint races only."
      }
    ]
  }
}
